<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.codingbattle.controller.LoginController"
           styleClass="main-window" prefWidth="1200.0" prefHeight="780.0">

    <VBox alignment="CENTER" spacing="20.0" maxWidth="500.0">
        <!-- Logo & Branding -->
        <VBox alignment="CENTER" spacing="6.0">
            <Label text="⚡ CODING BATTLE" styleClass="heading-large" style="-fx-font-size: 32px; -fx-text-fill: #58a6ff; -fx-font-weight: bold;"/>
            <Label text="Competitive Programming &amp; Academic Examination Arena" styleClass="subheading" style="-fx-font-size: 13.5px;"/>
        </VBox>

        <!-- Unified Single Login Card -->
        <VBox styleClass="card" spacing="16.0" style="-fx-padding: 20px; -fx-background-color: #161b22; -fx-background-radius: 12px; -fx-border-color: #30363d; -fx-border-radius: 12px;">
            <TabPane fx:id="authTabPane" tabClosingPolicy="UNAVAILABLE">
                
                <!-- 1. STUDENT LOGIN TAB -->
                <Tab text="🎓 Student Login">
                    <VBox spacing="14.0">
                        <padding>
                            <Insets top="16.0" bottom="8.0" left="4.0" right="4.0"/>
                        </padding>

                        <VBox spacing="6.0">
                            <Label text="STUDENT USERNAME / EMAIL" styleClass="card-stat-label" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                            <TextField fx:id="loginUsernameField" promptText="e.g. rahul or rahul@student.edu"/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label text="STUDENT PASSWORD" styleClass="card-stat-label" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                            <PasswordField fx:id="loginPasswordField" promptText="••••••••"/>
                        </VBox>

                        <Label fx:id="loginMessageLabel" wrapText="true"/>

                        <Button text="⚡ Enter Student Arena" onAction="#handleLogin" maxWidth="Infinity" styleClass="btn-primary" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 11;"/>

                        <Separator style="-fx-background-color: #30363d;"/>
                        <HBox spacing="10.0">
                            <Button text="⚡ 1-Click Student Demo (rahul)" onAction="#fillStudentDemo" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-font-size: 11.5px; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>
                </Tab>

                <!-- 2. FACULTY LOGIN TAB -->
                <Tab text="🛡️ Faculty Login">
                    <VBox spacing="14.0">
                        <padding>
                            <Insets top="16.0" bottom="8.0" left="4.0" right="4.0"/>
                        </padding>

                        <!-- Faculty Banner -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: rgba(99, 102, 241, 0.15); -fx-padding: 10px; -fx-background-radius: 8px; -fx-border-color: rgba(129, 140, 248, 0.4); -fx-border-radius: 8px;">
                            <Label text="🛡️" style="-fx-font-size: 20px;"/>
                            <VBox spacing="2.0">
                                <Label text="Faculty &amp; Chief Evaluator Portal" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #e0e7ff;"/>
                                <Label text="Full access to student streak tracking, exams &amp; proctoring." style="-fx-font-size: 10.5px; -fx-text-fill: #a5b4fc;"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="6.0">
                            <Label text="FACULTY ID / USERNAME" styleClass="card-stat-label" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                            <TextField fx:id="facultyUsernameField" text="admin" promptText="e.g. admin"/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label text="MASTER FACULTY KEY" styleClass="card-stat-label" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                            <PasswordField fx:id="facultyPasswordField" text="admin123" promptText="••••••••"/>
                        </VBox>

                        <Label fx:id="facultyMessageLabel" wrapText="true"/>

                        <Button text="🛡️ Enter Faculty Command Portal" onAction="#handleFacultyLogin" maxWidth="Infinity" styleClass="btn-primary" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 11; -fx-background-color: linear-gradient(to right, #4f46e5, #7c3aed);"/>

                        <Separator style="-fx-background-color: #30363d;"/>
                        <HBox spacing="10.0">
                            <Button text="⚡ 1-Click Faculty Demo (admin)" onAction="#fillFacultyDemo" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-font-size: 11.5px; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>
                </Tab>

                <!-- 3. STUDENT REGISTRATION TAB -->
                <Tab text="✨ Create Account">
                    <VBox spacing="12.0">
                        <padding>
                            <Insets top="16.0" bottom="8.0" left="4.0" right="4.0"/>
                        </padding>

                        <VBox spacing="6.0">
                            <Label text="Username" styleClass="card-stat-label"/>
                            <TextField fx:id="regUsernameField" promptText="Choose a unique username"/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label text="Campus Email" styleClass="card-stat-label"/>
                            <TextField fx:id="regEmailField" promptText="coder@student.edu"/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label text="Password" styleClass="card-stat-label"/>
                            <PasswordField fx:id="regPasswordField" promptText="At least 4 characters"/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label text="Confirm Password" styleClass="card-stat-label"/>
                            <PasswordField fx:id="regConfirmPasswordField" promptText="Re-enter password"/>
                        </VBox>

                        <Label fx:id="regMessageLabel" wrapText="true"/>

                        <Button text="🚀 Register as Student" onAction="#handleRegister" maxWidth="Infinity" styleClass="btn-accent" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10;"/>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>

        <!-- Database Connection Indicator -->
        <HBox alignment="CENTER" spacing="8.0">
            <Label text="●" style="-fx-text-fill: #3fb950; -fx-font-size: 14px;"/>
            <Label fx:id="dbStatusLabel" text="Database: Online" styleClass="subheading"/>
        </HBox>
    </VBox>
</StackPane>
