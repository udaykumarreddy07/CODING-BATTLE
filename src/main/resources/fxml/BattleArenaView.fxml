<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codingbattle.controller.BattleArenaController"
      spacing="16.0">

    <!-- Header & Battle Selector -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="Coding Battle Arena" styleClass="heading-large"/>
            <Label text="Compete in real-time programming battles against other coders." styleClass="subheading"/>
        </VBox>

        <HBox alignment="CENTER" spacing="10.0">
            <Label text="Select Contest:" styleClass="card-stat-label"/>
            <ComboBox fx:id="battleSelectCombo" prefWidth="240.0"/>
        </HBox>
    </HBox>

    <!-- Contest Arena Card -->
    <VBox fx:id="activeBattlePanel" styleClass="card" spacing="16.0">
        <!-- Top Battle Status & Countdown Timer Bar -->
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label fx:id="battleTitleLabel" text="Java Speed Battle #05" styleClass="heading-large" style="-fx-font-size: 20px;"/>
                    <Label fx:id="battleStatusBadge" text="LIVE" styleClass="badge-pill, badge-live"/>
                </HBox>
                <Label fx:id="solvedCountLabel" text="Solved: 0 / 5" style="-fx-text-fill: #3fb950; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Big Countdown Timer -->
            <VBox alignment="CENTER" spacing="2.0">
                <Label text="TIME REMAINING" styleClass="card-stat-label" style="-fx-font-size: 10px;"/>
                <Label fx:id="timerLabel" text="45:00" styleClass="timer-display"/>
            </VBox>
        </HBox>

        <Separator style="-fx-background-color: #30363d;"/>

        <!-- Battle Problems Ribbon -->
        <VBox spacing="8.0">
            <Label text="CONTEST CHALLENGES (Click to open code editor):" styleClass="card-stat-label"/>
            <HBox fx:id="problemsRibbon" spacing="10.0" alignment="CENTER_LEFT"/>
        </VBox>
    </VBox>

    <!-- Live Contest Standings -->
    <VBox styleClass="card" spacing="10.0" VBox.vgrow="ALWAYS">
        <Label text="Live Contest Standings" styleClass="heading-medium"/>
        <TableView fx:id="battleScoreTable" VBox.vgrow="ALWAYS" prefHeight="300.0">
            <columns>
                <TableColumn fx:id="colRank" text="Rank" prefWidth="80.0"/>
                <TableColumn fx:id="colUser" text="Student / Competitor" prefWidth="300.0"/>
                <TableColumn fx:id="colScore" text="Total Score" prefWidth="180.0"/>
                <TableColumn fx:id="colSolved" text="Problems Solved" prefWidth="180.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
